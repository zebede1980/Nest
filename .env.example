# All optional. Copy to .env next to docker-compose.yml (mode 600).

# The address people use; links and notification taps point here.
# APP_URL=https://nest.terminuscloud.giize.com

# Push keys are made on first start and kept in the database. Set these only to
# move keys between installs (changing them breaks every existing subscription).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# The contact Apple/Google see on push requests (mailto: or https:). Defaults to APP_URL.
# VAPID_SUBJECT=mailto:you@example.com
