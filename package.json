{
  "name": "nest",
  "version": "0.1.0",
  "private": true,
  "description": "Nest: the jobs around our home, who is doing them, what they cost and how far we have come",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c green,cyan \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "PORT=3072 tsx watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist-server/server/src/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "admin": "node --disable-warning=ExperimentalWarning dist-server/server/src/cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.5",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
